# ── Existing ─────────────────────────────────────────────────────
CDMAD_LOCAL_DEV=1
CDMAD_DRIFT_THRESHOLD=0.5

# ANTHROPIC_API_KEY removed — the memory gate no longer calls an LLM.
# Re-add only if AnthropicClient is re-enabled in memory/llm_client.py:
# ANTHROPIC_API_KEY=your-key-here

# ── Memory gate / VDB ────────────────────────────────────────────
CDMAD_STORE=json                              # json | vdb — contract store backend
CDMAD_VDB_PATH=.cdmad/vdb                      # VDB root directory
# CDMAD_REPO_NAME=ci-wrapper                   # override repo name (default: auto from git)
CDMAD_SCHEMA_PATH=.cdmad/session_schema.json   # where the agent writes its declared schema
# CDMAD_AGENT_ID=                              # agent's live schema id (default: auto hostname+pid)
# CDMAD_MANAGED=1                              # set by the Conductor — read-only managed mode
CDMAD_PEER_CHECK=1                             # 0 disables intra-session peer checking
CDMAD_RETRIEVAL_TOP_K=20                       # max contracts retrieved per commit (future ChromaDB)
